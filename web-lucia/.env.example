# Copia este archivo como .env y rellena los valores.

# Cadena de conexión de MongoDB (MongoDB Atlas o local)
# Atlas: mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/lucia-castro?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/lucia-castro
MONGODB_URI=mongodb://127.0.0.1:27017/lucia-castro

# Contraseña del panel /admin (mínimo 16 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Puerto del servidor
PORT=3000

# Solo si la web se publica en un dominio distinto al de la API (separados por comas)
# CORS_ORIGIN=https://luciacastro.es
